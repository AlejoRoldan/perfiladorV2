# Copy this file to .env and fill in real values locally.
# Never commit real credentials, API keys, tokens, or production URLs.

# PostgreSQL + pgvector
# Local Docker default:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/perfilador_db"
# Supabase example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Redis / BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379

# GitHub Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# AI Provider API Keys
GEMINI_API_KEY=""

# App Secrets
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
ADMIN_IMPORT_TOKEN=""
PILOT_IMPORT_ORG_SLUG="itti"
