{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@perfilador/sanitizer": ["../../packages/sanitizer/src/index.ts"],
      "@perfilador/schemas": ["../../packages/schemas/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}